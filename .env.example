# Copy to .env and fill in. Never commit .env.
#
# This project has no cloud backend and no secrets: the git repository is
# the storage layer. The only settings are optional path overrides, with
# identical names locally and in GitHub Actions.

# Data root holding raw/, _manifests/, data_warehouse/ (default: repo data/)
# DATA_DIR=

# Raw HTML snapshot dir for debugging (default: <data>/raw_html, gitignored)
# RAW_HTML_DIR=

# dbt raw-zone location (default: ../data relative to dbt-transform/;
# CI fixtures: tests/fixtures)
# RAW_BASE_PATH=

# Dashboard published-exports location (default: repo data/data_warehouse,
# or a bundled data_warehouse/ next to the standalone app)
# WAREHOUSE_DIR=
